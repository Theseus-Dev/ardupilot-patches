index cf3f841cde..4290896d1a 100644
--- a/libraries/AP_NavEKF3/AP_NavEKF3_Outputs.cpp
+++ b/libraries/AP_NavEKF3/AP_NavEKF3_Outputs.cpp
@@ -258,6 +258,15 @@ bool NavEKF3_core::getPosNE(Vector2f &posNE) const
     } else {
         // In constant position mode the EKF position states are at the origin, so we cannot use them as a position estimate
         if(validOrigin) {
+            // External-position-bootstrap path: if the option bit is set and the origin
+            // has been provided, publish the position state (held at the origin by AID_NONE
+            // constant-position fusion) so LOCAL_POSITION_NED consumers wake up before
+            // the in-air bootstrap. A companion-computer position source can then come up
+            // and start sending fixes via MAV_CMD_EXTERNAL_POSITION_ESTIMATE.
+            if (frontend->_options & (int32_t)NavEKF3::Options::ExtPosCanBootstrap) {
+                posNE = (outputDataNew.position.xy() + public_origin.get_distance_NE_ftype(EKF_origin)).tofloat();
+                return true;
+            }
             auto &gps = dal.gps();
             if ((gps.status(selected_gps) >= AP_DAL_GPS::GPS_OK_FIX_2D)) {
                 // If the origin has been set and we have GPS, then return the GPS position relative to the origin
diff --git a/libraries/AP_NavEKF3/AP_NavEKF3_PosVelFusion.cpp b/libraries/AP_NavEKF3/AP_NavEKF3_PosVelFusion.cpp
index 76435f5fc7..1c5ae2c651 100644
--- a/libraries/AP_NavEKF3/AP_NavEKF3_PosVelFusion.cpp
+++ b/libraries/AP_NavEKF3/AP_NavEKF3_PosVelFusion.cpp
@@ -190,9 +190,18 @@ void NavEKF3_core::ResetPosition(resetDataSource posResetSource)
 // Returns true if the set was successful
 bool NavEKF3_core::setLatLng(const Location &loc, float posAccuracy, uint32_t timestamp_ms)
 {
+    // External-position-bootstrap path: when EK3_OPTIONS bit ExtPosCanBootstrap is set,
+    // allow a setLatLng call to transition the filter from AID_NONE to AID_ABSOLUTE if
+    // the vehicle is in flight. Gated on inFlight (not just !onGround) so on-ground
+    // compass/sensor effects can't be baked into the bootstrap state, and so that the
+    // first accepted fix happens with the IMU in its flight motion regime.
+    const bool bootstrap_allowed =
+        (frontend->_options & (int32_t)NavEKF3::Options::ExtPosCanBootstrap) &&
+        validOrigin && PV_AidingMode == AID_NONE && inFlight;
+
     if ((imuSampleTime_ms - lastGpsPosPassTime_ms) < frontend->deadReckonDeclare_ms ||
-        (PV_AidingMode == AID_NONE)
-        || !validOrigin) {
+        (PV_AidingMode == AID_NONE && !bootstrap_allowed) ||
+        !validOrigin) {
         return false;
     }
 
@@ -220,6 +229,34 @@ bool NavEKF3_core::setLatLng(const Location &loc, float posAccuracy, uint32_t ti
     const Vector2F newPosNE = EKF_origin.get_distance_NE_ftype(loc) + stateStruct.velocity.xy() * delaySec;
     ResetPositionNE(newPosNE.x,newPosNE.y);
 
+    // Keep lastKnownPositionNE in sync so AID_NONE constant-position fusion (if we
+    // ever fall back) holds at the externally-provided location rather than (0,0).
+    lastKnownPositionNE.x = newPosNE.x;
+    lastKnownPositionNE.y = newPosNE.y;
+
+    if (bootstrap_allowed) {
+        // Open the velocity covariance so the airspeed/sideslip fusion path can build
+        // velocity from scratch. On the first bootstrap, velocity state is whatever
+        // AID_NONE constant-position fusion left it at (~zero). _gpsHorizVelNoise's
+        // typical default is too tight to absorb large early innovations.
+        zeroRows(P,4,5);
+        zeroCols(P,4,5);
+        P[4][4] = sq(25.0f);
+        P[5][5] = sq(25.0f);
+
+        // Transition to AID_ABSOLUTE and refresh timeouts so the health checks in
+        // setAidingMode() don't immediately push us back to AID_NONE.
+        PV_AidingMode = AID_ABSOLUTE;
+        posTimeout = false;
+        velTimeout = false;
+        tasTimeout = false;
+        lastGpsPosPassTime_ms = imuSampleTime_ms;
+        lastVelPassTime_ms = imuSampleTime_ms;
+        _has_forced_position = true;
+
+        GCS_SEND_TEXT(MAV_SEVERITY_INFO, "EKF3 IMU%u aiding from external pos", (unsigned)imu_index);
+    }
+
     return true;
 }
 #endif // EK3_FEATURE_POSITION_RESET
