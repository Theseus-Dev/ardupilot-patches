diff --git a/libraries/AP_NavEKF3/AP_NavEKF3_Control.cpp b/libraries/AP_NavEKF3/AP_NavEKF3_Control.cpp
index 3eea5d16d2..99cca31ffe 100644
--- a/libraries/AP_NavEKF3/AP_NavEKF3_Control.cpp
+++ b/libraries/AP_NavEKF3/AP_NavEKF3_Control.cpp
@@ -313,6 +313,18 @@ void NavEKF3_core::setAidingMode()
             break;
         }
         case AID_ABSOLUTE: {
+            // External-position-bootstrap keepalive: when the filter has been
+            // bootstrapped from an external position estimate, refresh the position
+            // pass time every cycle so attAidLossCritical/posAidLossCritical can't
+            // drop us back to AID_NONE between fixes. The companion's fix cadence
+            // (e.g. 500m / ~20s for typical Cyclops conop) is longer than the
+            // EKF's posRetryTime_ms timeouts, so without this keepalive a single
+            // fix gap would tear down the aiding mode and the bootstrap path is
+            // single-shot (only triggers from AID_NONE).
+            if (_has_forced_position) {
+                lastGpsPosPassTime_ms = imuSampleTime_ms;
+            }
+
             // Find the minimum time without data required to trigger any check
             uint16_t minTestTime_ms = MIN(frontend->tiltDriftTimeMax_ms, MIN(frontend->posRetryTimeNoVel_ms,frontend->posRetryTimeUseVel_ms));
 
