From 7b7cfc7f06d8f7a6b0bb6f2f53b1d2ab6a3d43d1 Mon Sep 17 00:00:00 2001
From: sacha <sacha@theseus.ai>
Date: Sat, 16 May 2026 18:59:00 -0700
Subject: [PATCH 5/5] AP_NavEKF3: learn wind only while external position is
 fresh

The forced-position no-GPS path previously froze wind for the entire
bootstrap flight. That prevents the EKF from refining a companion-supplied
wind estimate while external position fixes are still arriving, and the
inhibited-wind covariance path also zeroed the wind variances, making a
stale injected wind look exact.

Track the timestamp of the last accepted external position estimate. While
forced-position mode is active and the most recent fix is fresh, allow TAS
and sideslip fusion to refine wind. Once external position fixes go stale,
freeze wind again so wind and velocity cannot co-drift indefinitely during
pure dead reckoning.

When freezing wind in forced-position mode, preserve the wind covariance
diagonal after zeroing wind cross-covariances. The wind state can be held
fixed without being represented as exact truth.
---
 libraries/AP_NavEKF3/AP_NavEKF3_Control.cpp      | 15 +++++++--------
 libraries/AP_NavEKF3/AP_NavEKF3_PosVelFusion.cpp |  1 +
 libraries/AP_NavEKF3/AP_NavEKF3_core.cpp         |  7 +++++++
 libraries/AP_NavEKF3/AP_NavEKF3_core.h           |  1 +
 4 files changed, 16 insertions(+), 8 deletions(-)

diff --git a/libraries/AP_NavEKF3/AP_NavEKF3_Control.cpp b/libraries/AP_NavEKF3/AP_NavEKF3_Control.cpp
index 706520a1f0..bf2106e635 100644
--- a/libraries/AP_NavEKF3/AP_NavEKF3_Control.cpp
+++ b/libraries/AP_NavEKF3/AP_NavEKF3_Control.cpp
@@ -59,17 +59,16 @@ NavEKF3_core::MagCal NavEKF3_core::effective_magCal(void) const
 // avoid unnecessary operations
 void NavEKF3_core::setWindMagStateLearningMode()
 {
-    // External-position-bootstrap path: when _has_forced_position is set, the EKF
-    // is operating without absolute velocity aiding (no GPS). In that regime
-    // velocity and wind are jointly unobservable from TAS+sideslip alone -- both
-    // can drift together while preserving |vel - wind| = airspeed, producing
-    // runaway ground speed. Keep wind frozen at whatever value the companion
-    // supplied (see NavEKF3_core::setExternalWind) and never let the filter
-    // try to learn wind in this regime.
+    // External-position-bootstrap path: while external position fixes are arriving,
+    // let TAS/sideslip fusion refine wind. Once the fixes go stale, freeze the wind
+    // state again so velocity and wind cannot co-drift indefinitely in dead reckoning.
+    const bool forcedPositionFresh = !_has_forced_position ||
+                                     (lastForcedPositionSet_ms != 0 &&
+                                      imuSampleTime_ms - lastForcedPositionSet_ms <= 5000);
     const bool canEstimateWind = ((finalInflightYawInit && dragFusionEnabled) || assume_zero_sideslip()) &&
                                  !onGround &&
                                  PV_AidingMode != AID_NONE &&
-                                 !_has_forced_position;
+                                 forcedPositionFresh;
     if (!inhibitWindStates && !canEstimateWind) {
         inhibitWindStates = true;
         lastAspdEstIsValid = false;
diff --git a/libraries/AP_NavEKF3/AP_NavEKF3_PosVelFusion.cpp b/libraries/AP_NavEKF3/AP_NavEKF3_PosVelFusion.cpp
index 449d9db39c..187679e0ca 100644
--- a/libraries/AP_NavEKF3/AP_NavEKF3_PosVelFusion.cpp
+++ b/libraries/AP_NavEKF3/AP_NavEKF3_PosVelFusion.cpp
@@ -254,6 +254,7 @@ bool NavEKF3_core::setLatLng(const Location &loc, float posAccuracy, uint32_t ti
     // ever fall back) holds at the externally-provided location rather than (0,0).
     lastKnownPositionNE.x = newPosNE.x;
     lastKnownPositionNE.y = newPosNE.y;
+    lastForcedPositionSet_ms = imuSampleTime_ms;
 
     if (bootstrap_allowed) {
         // Open the velocity covariance so the airspeed/sideslip fusion path can build
diff --git a/libraries/AP_NavEKF3/AP_NavEKF3_core.cpp b/libraries/AP_NavEKF3/AP_NavEKF3_core.cpp
index 72496cac41..3b149e2730 100644
--- a/libraries/AP_NavEKF3/AP_NavEKF3_core.cpp
+++ b/libraries/AP_NavEKF3/AP_NavEKF3_core.cpp
@@ -243,6 +243,7 @@ void NavEKF3_core::InitialiseVariables()
     lastKnownPositionNE.zero();
     lastKnownPositionD = 0;
     _has_forced_position = false;
+    lastForcedPositionSet_ms = 0;
     prevTnb.zero();
     memset(&P[0][0], 0, sizeof(P));
     memset(&KH[0][0], 0, sizeof(KH));
@@ -1984,8 +1985,14 @@ void NavEKF3_core::ConstrainVariances()
             for (uint8_t i=22; i<=23; i++) P[i][i] = constrain_ftype(P[i][i],0.0f,WIND_VEL_VARIANCE_MAX);
         }
     } else {
+        const ftype windVarN = P[22][22];
+        const ftype windVarE = P[23][23];
         zeroCols(P,22,23);
         zeroRows(P,22,23);
+        if (_has_forced_position && windStatesAligned) {
+            P[22][22] = constrain_ftype(windVarN, 0.0f, WIND_VEL_VARIANCE_MAX);
+            P[23][23] = constrain_ftype(windVarE, 0.0f, WIND_VEL_VARIANCE_MAX);
+        }
     }
 }
 
diff --git a/libraries/AP_NavEKF3/AP_NavEKF3_core.h b/libraries/AP_NavEKF3/AP_NavEKF3_core.h
index bdebe9241e..68fafde6d8 100644
--- a/libraries/AP_NavEKF3/AP_NavEKF3_core.h
+++ b/libraries/AP_NavEKF3/AP_NavEKF3_core.h
@@ -1146,6 +1146,7 @@ private:
     Vector2F lastKnownPositionNE;   // last known position
     float lastKnownPositionD;       // last known height
     bool _has_forced_position;      // true after a successful AID_NONE -> AID_ABSOLUTE bootstrap via external position estimate (EK3_OPTIONS bit 3)
+    uint32_t lastForcedPositionSet_ms; // time stamp when setLatLng last accepted an external position estimate (msec)
     uint32_t lastLaunchAccelTime_ms;
     ftype velTestRatio;             // sum of squares of GPS velocity innovation divided by fail threshold
     ftype posTestRatio;             // sum of squares of GPS position innovation divided by fail threshold
